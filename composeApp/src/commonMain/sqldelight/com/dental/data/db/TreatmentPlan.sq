CREATE TABLE TreatmentPlanEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    patientId INTEGER NOT NULL,
    toothNumbers TEXT NOT NULL,
    procedure TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

getByPatientId:
SELECT * FROM TreatmentPlanEntity WHERE patientId = ? ORDER BY createdAt;

insert:
INSERT INTO TreatmentPlanEntity(patientId, toothNumbers, procedure, createdAt)
VALUES (?, ?, ?, ?);

insertWithId:
INSERT OR REPLACE INTO TreatmentPlanEntity(id, patientId, toothNumbers, procedure, createdAt)
VALUES (?, ?, ?, ?, ?);

deleteByPatientId:
DELETE FROM TreatmentPlanEntity WHERE patientId = ?;

getAll:
SELECT * FROM TreatmentPlanEntity;

deleteAll:
DELETE FROM TreatmentPlanEntity;

getLastInsertId:
SELECT last_insert_rowid();
