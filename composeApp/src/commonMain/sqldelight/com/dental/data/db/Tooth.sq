CREATE TABLE ToothEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    patientId INTEGER NOT NULL,
    number INTEGER NOT NULL,
    arch TEXT NOT NULL,
    quadrant INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'PRESENT',
    examType TEXT,
    crownOption TEXT,
    rootOption TEXT
);

getByPatientId:
SELECT * FROM ToothEntity WHERE patientId = ?;

getByPatientIdAndExamType:
SELECT * FROM ToothEntity WHERE patientId = ? AND examType = ?;

upsert:
INSERT OR REPLACE INTO ToothEntity(id, patientId, number, arch, quadrant, status, examType, crownOption, rootOption)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insert:
INSERT INTO ToothEntity(patientId, number, arch, quadrant, status, examType, crownOption, rootOption)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateStatus:
UPDATE ToothEntity SET status = ? WHERE patientId = ? AND number = ?;

updateCrownOption:
UPDATE ToothEntity SET crownOption = ? WHERE patientId = ? AND number = ?;

updateRootOption:
UPDATE ToothEntity SET rootOption = ? WHERE patientId = ? AND number = ?;

deleteByPatientId:
DELETE FROM ToothEntity WHERE patientId = ?;

getAll:
SELECT * FROM ToothEntity;

deleteAll:
DELETE FROM ToothEntity;
