CREATE TABLE AppointmentEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    patientId INTEGER NOT NULL,
    startTime INTEGER NOT NULL,
    endTime INTEGER NOT NULL,
    durationMinutes INTEGER NOT NULL DEFAULT 30,
    doctorId INTEGER,
    chairId INTEGER,
    type TEXT NOT NULL DEFAULT 'INITIAL',
    status TEXT NOT NULL DEFAULT 'PLANNED',
    note TEXT
);

getByDateRange:
SELECT * FROM AppointmentEntity
WHERE startTime >= ? AND startTime < ?
ORDER BY startTime;

getByPatientId:
SELECT * FROM AppointmentEntity
WHERE patientId = ?
ORDER BY startTime DESC;

getById:
SELECT * FROM AppointmentEntity WHERE id = ?;

insert:
INSERT INTO AppointmentEntity(patientId, startTime, endTime, durationMinutes, doctorId, chairId, type, status, note)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateStatus:
UPDATE AppointmentEntity SET status = ? WHERE id = ?;

deleteById:
DELETE FROM AppointmentEntity WHERE id = ?;
